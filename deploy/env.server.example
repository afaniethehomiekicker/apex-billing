# APEX Billing on the Linux server: /opt/apex-billing/.env
# Fill in the values marked <...>, then:  sudo chown root:apexbilling .env && sudo chmod 640 .env

GIN_MODE=release
# Protects stored two-step sign-in keys. Make it with:  openssl rand -hex 32
# Never change it later (everyone's two-step sign-in would stop working).
APP_SECRET=<openssl rand -hex 32>

# HTTPS served by the program itself, on the normal HTTPS port.
PORT=443
TLS_ENABLED=true
TLS_CERT_FILE=/opt/apex-billing/tls/cert.pem
TLS_KEY_FILE=/opt/apex-billing/tls/key.pem

# Database on this server, with the app's own limited user (scripts/db-setup.sql).
DB_HOST=localhost
DB_PORT=5432
DB_USER=apex_billing_app
DB_PASSWORD=<the password you put in db-setup.sql>
DB_NAME=apex_billing
DB_TIMEZONE=Asia/Karachi

# Payment slips, logos, contracts, profile pictures.
UPLOAD_DIR=/var/lib/apex-billing/uploads

# FIRST START ONLY: the first admin. Delete these two lines after the first
# start (the admin chooses a new password at first sign-in).
BILLING_ADMIN_EMAIL=<your email>
BILLING_ADMIN_PASSWORD=<a temporary password, 10+ letters and numbers>
