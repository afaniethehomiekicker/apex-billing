# APEX Billing as a service: starts at boot, restarts if it stops, runs as
# its own user with no access to the rest of the system.
# Install:  sudo cp apex-billing.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now apex-billing
[Unit]
Description=APEX Billing
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=apexbilling
Group=apexbilling
WorkingDirectory=/opt/apex-billing
ExecStart=/opt/apex-billing/apex-billing
Restart=on-failure
RestartSec=5

# May use port 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Lock-down: read-only system, only the uploads folder is writable.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0027
ReadWritePaths=/var/lib/apex-billing

[Install]
WantedBy=multi-user.target
